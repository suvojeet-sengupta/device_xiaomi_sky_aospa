<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <ListPreference
        android:key="touch_game_mode"
        android:title="@string/touch_game_mode_title"
        android:entries="@array/touch_game_entries"
        android:entryValues="@array/touch_game_values"
        android:defaultValue="auto"
        android:summary="%s"
        android:persistent="false" />

    <Preference
        android:key="touch_game_footer"
        android:summary="@string/touch_game_footer"
        android:selectable="false" />

</PreferenceScreen>
