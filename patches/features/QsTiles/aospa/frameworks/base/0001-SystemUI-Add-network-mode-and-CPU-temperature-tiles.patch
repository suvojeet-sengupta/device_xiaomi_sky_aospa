+package com.android.systemui.qs.tiles;
+
+import android.content.Intent;
+import android.os.Handler;
+import android.os.HardwarePropertiesManager;
+import android.os.Looper;
+import android.service.quicksettings.Tile;
+import android.util.Log;
+
+import androidx.annotation.Nullable;
+
+import com.android.systemui.plugins.qs.QSTile.State;
+import com.android.internal.logging.MetricsLogger;
+import com.android.internal.logging.nano.MetricsProto.MetricsEvent;
+import com.android.systemui.animation.Expandable;
+import com.android.systemui.dagger.qualifiers.Background;
+import com.android.systemui.dagger.qualifiers.Main;
+import com.android.systemui.plugins.ActivityStarter;
+import com.android.systemui.plugins.FalsingManager;
+import com.android.systemui.plugins.statusbar.StatusBarStateController;
+import com.android.systemui.qs.QSHost;
+import com.android.systemui.qs.QsEventLogger;
+import com.android.systemui.qs.logging.QSLogger;
+import com.android.systemui.qs.tileimpl.QSTileImpl;
+import com.android.systemui.res.R;
+
+import javax.inject.Inject;
+
+/**
+ * Quick settings tile: shows the hottest CPU temperature the thermal HAL reports, every two
+ * seconds while quick settings is open.
+ */
+public class CpuTempTile extends QSTileImpl<State> {
+
+    public static final String TILE_SPEC = "cpu_temp";
+
+    private static final String TAG = "CpuTempTile";
+    private static final long UPDATE_INTERVAL_MS = 2000;
+
+    @Nullable
+    private Icon mIcon;
+    private boolean mListening;
+
+    private final Runnable mUpdate = new Runnable() {
+        @Override
+        public void run() {
+            refreshState();
+            if (mListening) {
+                mHandler.postDelayed(this, UPDATE_INTERVAL_MS);
+            }
+        }
+    };
+
+    @Inject
+    public CpuTempTile(
+            QSHost host,
+            QsEventLogger uiEventLogger,
+            @Background Looper backgroundLooper,
+            @Main Handler mainHandler,
+            FalsingManager falsingManager,
+            MetricsLogger metricsLogger,
+            StatusBarStateController statusBarStateController,
+            ActivityStarter activityStarter,
+            QSLogger qsLogger
+    ) {
+        super(host, uiEventLogger, backgroundLooper, mainHandler, falsingManager, metricsLogger,
+                statusBarStateController, activityStarter, qsLogger);
+    }
+
+    @Override
+    public State newTileState() {
+        return new State();
+    }
+
+    @Override
+    public void handleSetListening(boolean listening) {
+        super.handleSetListening(listening);
+        if (mListening == listening) return;
+        mListening = listening;
+        mHandler.removeCallbacks(mUpdate);
+        if (listening) {
+            mHandler.post(mUpdate);
+        }
+    }
+
+    @Override
+    protected void handleDestroy() {
+        mListening = false;
+        mHandler.removeCallbacks(mUpdate);
+        super.handleDestroy();
+    }
+
+    @Override
+    public boolean isAvailable() {
+        return mContext.getSystemService(HardwarePropertiesManager.class) != null;
+    }
+
+    /** The hottest CPU in degrees Celsius, or NaN when there is no reading. */
+    private float readCpuTemperature() {
+        final HardwarePropertiesManager hpm =
+                mContext.getSystemService(HardwarePropertiesManager.class);
+        if (hpm == null) {
+            return Float.NaN;
+        }
+        float max = Float.NaN;
+        try {
+            final float[] temps = hpm.getDeviceTemperatures(
+                    HardwarePropertiesManager.DEVICE_TEMPERATURE_CPU,
+                    HardwarePropertiesManager.TEMPERATURE_CURRENT);
+            for (float t : temps) {
+                if (t == HardwarePropertiesManager.UNDEFINED_TEMPERATURE
+                        || Float.isNaN(t) || Float.isInfinite(t)) {
+                    continue;
+                }
+                if (Float.isNaN(max) || t > max) {
+                    max = t;
+                }
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Couldn't read the CPU temperature", e);
+        }
+        return max;
+    }
+
+    @Override
+    protected void handleClick(@Nullable Expandable expandable) {
+        refreshState();
+    }
+
+    @Override
+    public Intent getLongClickIntent() {
+        return new Intent(Intent.ACTION_POWER_USAGE_SUMMARY);
+    }
+
+    @Override
+    public CharSequence getTileLabel() {
+        return mContext.getString(R.string.quick_settings_cpu_temp_label);
+    }
+
+    @Override
+    protected void handleUpdateState(State state, Object arg) {
+        if (mIcon == null) {
+            mIcon = maybeLoadResourceIcon(R.drawable.ic_device_thermostat_24);
+        }
+        state.icon = mIcon;
+        state.label = mContext.getString(R.string.quick_settings_cpu_temp_label);
+        final float temp = readCpuTemperature();
+        if (Float.isNaN(temp)) {
+            state.state = Tile.STATE_UNAVAILABLE;
+            state.secondaryLabel = null;
+        } else {
+            state.state = Tile.STATE_ACTIVE;
+            state.secondaryLabel = mContext.getString(R.string.quick_settings_cpu_temp_value,
+                    Math.round(temp));
+        }
+        state.contentDescription = state.label + ", " + (state.secondaryLabel == null
+                ? "" : state.secondaryLabel);
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return MetricsEvent.QS_PANEL;
+    }
+}
diff --git a/packages/SystemUI/src/com/android/systemui/qs/tiles/NetworkModeTile.java b/packages/SystemUI/src/com/android/systemui/qs/tiles/NetworkModeTile.java
new file mode 100644
index 000000000000..24aeb5f679c4
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/qs/tiles/NetworkModeTile.java
@@ -0,0 +1,186 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Paranoid Android
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.systemui.qs.tiles;
+
+import static android.telephony.TelephonyManager.ALLOWED_NETWORK_TYPES_REASON_USER;
+import static android.telephony.TelephonyManager.NETWORK_TYPE_BITMASK_LTE;
+import static android.telephony.TelephonyManager.NETWORK_TYPE_BITMASK_LTE_CA;
+import static android.telephony.TelephonyManager.NETWORK_TYPE_BITMASK_NR;
+
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.service.quicksettings.Tile;
+import android.telephony.SubscriptionManager;
+import android.telephony.TelephonyManager;
+import android.util.Log;
+import android.widget.Switch;
+
+import androidx.annotation.Nullable;
+
+import com.android.systemui.plugins.qs.QSTile.BooleanState;
+import com.android.internal.logging.MetricsLogger;
+import com.android.internal.logging.nano.MetricsProto.MetricsEvent;
+import com.android.systemui.animation.Expandable;
+import com.android.systemui.dagger.qualifiers.Background;
+import com.android.systemui.dagger.qualifiers.Main;
+import com.android.systemui.plugins.ActivityStarter;
+import com.android.systemui.plugins.FalsingManager;
+import com.android.systemui.plugins.statusbar.StatusBarStateController;
+import com.android.systemui.qs.QSHost;
+import com.android.systemui.qs.QsEventLogger;
+import com.android.systemui.qs.logging.QSLogger;
+import com.android.systemui.qs.tileimpl.QSTileImpl;
+import com.android.systemui.res.R;
+
+import javax.inject.Inject;
+
+/**
+ * Quick settings tile: lets the SIM used for mobile data use 5G, or keeps it on 4G. It sets the
+ * same user allowed network types as the preferred network type in Settings, so Smart 5G, which
+ * uses its own reason, still applies on top.
+ */
+public class NetworkModeTile extends QSTileImpl<BooleanState> {
+
+    public static final String TILE_SPEC = "network_mode";
+
+    private static final String TAG = "NetworkModeTile";
+    private static final long LTE = NETWORK_TYPE_BITMASK_LTE | NETWORK_TYPE_BITMASK_LTE_CA;
+
+    @Nullable
+    private Icon m5gIcon;
+    @Nullable
+    private Icon m4gIcon;
+
+    @Inject
+    public NetworkModeTile(
+            QSHost host,
+            QsEventLogger uiEventLogger,
+            @Background Looper backgroundLooper,
+            @Main Handler mainHandler,
+            FalsingManager falsingManager,
+            MetricsLogger metricsLogger,
+            StatusBarStateController statusBarStateController,
+            ActivityStarter activityStarter,
+            QSLogger qsLogger
+    ) {
+        super(host, uiEventLogger, backgroundLooper, mainHandler, falsingManager, metricsLogger,
+                statusBarStateController, activityStarter, qsLogger);
+    }
+
+    @Override
+    public BooleanState newTileState() {
+        return new BooleanState();
+    }
+
+    @Override
+    public void handleSetListening(boolean listening) {
+        super.handleSetListening(listening);
+        if (listening) {
+            refreshState();
+        }
+    }
+
+    @Override
+    public boolean isAvailable() {
+        if (!mContext.getPackageManager().hasSystemFeature(
+                PackageManager.FEATURE_TELEPHONY_RADIO_ACCESS)) {
+            return false;
+        }
+        try {
+            final TelephonyManager tm = mContext.getSystemService(TelephonyManager.class);
+            return tm != null && (tm.getSupportedRadioAccessFamily() & NETWORK_TYPE_BITMASK_NR) != 0;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Couldn't read the supported radio access family", e);
+            return false;
+        }
+    }
+
+    /** The TelephonyManager of the SIM used for mobile data, or null without one. */
+    @Nullable
+    private TelephonyManager getDataTelephonyManager() {
+        final int subId = SubscriptionManager.getDefaultDataSubscriptionId();
+        if (!SubscriptionManager.isValidSubscriptionId(subId)) {
+            return null;
+        }
+        final TelephonyManager tm = mContext.getSystemService(TelephonyManager.class);
+        return tm == null ? null : tm.createForSubscriptionId(subId);
+    }
+
+    @Override
+    protected void handleClick(@Nullable Expandable expandable) {
+        final TelephonyManager tm = getDataTelephonyManager();
+        if (tm == null) {
+            return;
+        }
+        try {
+            final long allowed = tm.getAllowedNetworkTypesForReason(
+                    ALLOWED_NETWORK_TYPES_REASON_USER);
+            long next = (allowed & NETWORK_TYPE_BITMASK_NR) != 0
+                    ? allowed & ~NETWORK_TYPE_BITMASK_NR
+                    : allowed | NETWORK_TYPE_BITMASK_NR;
+            // Never leave the SIM without LTE.
+            next |= LTE;
+            tm.setAllowedNetworkTypesForReason(ALLOWED_NETWORK_TYPES_REASON_USER, next);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Couldn't change the allowed network types", e);
+        }
+        refreshState();
+    }
+
+    @Override
+    public Intent getLongClickIntent() {
+        return new Intent(Settings.ACTION_DATA_ROAMING_SETTINGS);
+    }
+
+    @Override
+    public CharSequence getTileLabel() {
+        return mContext.getString(R.string.quick_settings_network_mode_label);
+    }
+
+    @Override
+    protected void handleUpdateState(BooleanState state, Object arg) {
+        if (m5gIcon == null) {
+            m5gIcon = maybeLoadResourceIcon(com.android.settingslib.R.drawable.ic_5g_mobiledata);
+            m4gIcon = maybeLoadResourceIcon(com.android.settingslib.R.drawable.ic_4g_mobiledata);
+        }
+        state.label = mContext.getString(R.string.quick_settings_network_mode_label);
+        state.expandedAccessibilityClassName = Switch.class.getName();
+
+        final TelephonyManager tm = getDataTelephonyManager();
+        boolean nr = false;
+        boolean known = false;
+        if (tm != null) {
+            try {
+                nr = (tm.getAllowedNetworkTypesForReason(ALLOWED_NETWORK_TYPES_REASON_USER)
+                        & NETWORK_TYPE_BITMASK_NR) != 0;
+                known = true;
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Couldn't read the allowed network types", e);
+            }
+        }
+        state.value = nr;
+        state.icon = nr ? m5gIcon : m4gIcon;
+        if (!known) {
+            state.state = Tile.STATE_UNAVAILABLE;
+            state.secondaryLabel = null;
+        } else {
+            state.state = nr ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE;
+            state.secondaryLabel = mContext.getString(nr
+                    ? R.string.quick_settings_network_mode_5g
+                    : R.string.quick_settings_network_mode_4g);
+        }
+        state.contentDescription = state.label + ", " + (state.secondaryLabel == null
+                ? "" : state.secondaryLabel);
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return MetricsEvent.QS_PANEL;
+    }
+}
