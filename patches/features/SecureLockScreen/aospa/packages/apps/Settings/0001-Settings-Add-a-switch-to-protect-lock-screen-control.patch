diff --git a/src/com/android/settings/security/SecureLockScreenControlsPreferenceController.java b/src/com/android/settings/security/SecureLockScreenControlsPreferenceController.java
new file mode 100644
index 00000000000..7320e1148b6
--- /dev/null
+++ b/src/com/android/settings/security/SecureLockScreenControlsPreferenceController.java
@@ -0,0 +1,47 @@
+/*
+ * Copyright (C) 2026 Paranoid Android
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.security;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Makes sensitive Quick Settings tiles and power off or restart ask for an unlock on a
+ * secure lock screen, in Settings.Secure lockscreen_secure_controls.
+ */
+public class SecureLockScreenControlsPreferenceController extends TogglePreferenceController {
+    private static final String LOCKSCREEN_SECURE_CONTROLS = "lockscreen_secure_controls";
+
+    public SecureLockScreenControlsPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Secure.getInt(mContext.getContentResolver(),
+                LOCKSCREEN_SECURE_CONTROLS, 0) == 1;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.Secure.putInt(mContext.getContentResolver(),
+                LOCKSCREEN_SECURE_CONTROLS, isChecked ? 1 : 0);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_security;
+    }
+}
