+    // A tap on the tile turns mobile data on or off, like the toggle does. The internet dialog
+    // is still in the tile's details and in the Wi-Fi tile.
     suspend fun handleClick(expandable: Expandable?) {
+        handleSecondaryClick(expandable)
+    }
+
+    suspend fun handleSecondaryClick(expandable: Expandable?) {
+        val activeRepo = getDataRepo() ?: return
+        // Turn mobile data on or off right away, without asking to confirm.
+        activeRepo.setDataEnabled(!activeRepo.dataEnabled.value)
+    }
+
+    /** Opens the internet dialog. */
+    suspend fun showInternetDialog(expandable: Expandable?) {
         withContext(mainDispatcher) {
             internetDialogManager.create(
                 aboveStatusBar = true,
