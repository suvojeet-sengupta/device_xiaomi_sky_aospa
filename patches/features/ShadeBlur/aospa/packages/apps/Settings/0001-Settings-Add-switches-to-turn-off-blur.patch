+/*
+ * SPDX-FileCopyrightText: 2026 Paranoid Android
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.display;
+
+import static android.view.CrossWindowBlurListeners.CROSS_WINDOW_BLUR_SUPPORTED;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Turns off only the blur behind the notification panel and quick settings, in
+ * Settings.Secure sysui_shade_blur_disabled, which SystemUI's BlurUtils reads. Greyed out while
+ * all blur is off.
+ */
+public class DisablePanelBlurPreferenceController extends TogglePreferenceController {
+
+    static final String KEY = "display_disable_panel_blur";
+
+    private static final String SHADE_BLUR_DISABLED = "sysui_shade_blur_disabled";
+
+    public DisablePanelBlurPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return CROSS_WINDOW_BLUR_SUPPORTED ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        preference.setEnabled(!DisableAllBlurPreferenceController.isAllBlurDisabled(mContext));
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Secure.getInt(mContext.getContentResolver(),
+                SHADE_BLUR_DISABLED, 0) != 0;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.Secure.putInt(mContext.getContentResolver(),
+                SHADE_BLUR_DISABLED, isChecked ? 1 : 0);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_display;
+    }
+}
