+/*
+ * SPDX-FileCopyrightText: 2026 Paranoid Android
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.display;
+
+import static android.view.CrossWindowBlurListeners.CROSS_WINDOW_BLUR_SUPPORTED;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Turns off window blur everywhere, in Settings.Global.DISABLE_WINDOW_BLURS, the same setting
+ * as the blur switch in the accessibility color and motion settings.
+ */
+public class DisableAllBlurPreferenceController extends TogglePreferenceController {
+
+    private Preference mPanelBlurPreference;
+
+    public DisableAllBlurPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    static boolean isAllBlurDisabled(Context context) {
+        return Settings.Global.getInt(context.getContentResolver(),
+                Settings.Global.DISABLE_WINDOW_BLURS, 0) != 0;
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return CROSS_WINDOW_BLUR_SUPPORTED ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPanelBlurPreference = screen.findPreference(DisablePanelBlurPreferenceController.KEY);
+    }
+
+    @Override
+    public boolean isChecked() {
+        return isAllBlurDisabled(mContext);
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        final boolean saved = Settings.Global.putInt(mContext.getContentResolver(),
+                Settings.Global.DISABLE_WINDOW_BLURS, isChecked ? 1 : 0);
+        if (saved && mPanelBlurPreference != null) {
+            mPanelBlurPreference.setEnabled(!isChecked);
+        }
+        return saved;
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_display;
+    }
+}
