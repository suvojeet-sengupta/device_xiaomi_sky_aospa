From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Sun, 25 Oct 2026 18:22:15 +0000
Subject: [PATCH] Settings: Add a switch to use the VPN for hotspot clients

Hotspot & tethering gets "Use VPN for connected devices". It sets
Settings.Secure tethering_allow_vpn_upstreams, which Tethering reads to
follow the VPN of the main user as its upstream, so devices on the
hotspot go through the same VPN. Same setting and strings as LineageOS,
with an AOSP toggle controller instead of the LineageOS SDK preference.

Change-Id: Ia03fb687161492cab72f8deaf4b7d8e9b48ac585
---
 res/values/tethering_vpn_strings.xml          |  9 ++++
 res/xml/tether_prefs.xml                      |  6 +++
 ...AllowVpnUpstreamsPreferenceController.java | 47 +++++++++++++++++++
 3 files changed, 62 insertions(+)
 create mode 100644 res/values/tethering_vpn_strings.xml
 create mode 100644 src/com/android/settings/network/tether/TetheringAllowVpnUpstreamsPreferenceController.java

diff --git a/res/values/tethering_vpn_strings.xml b/res/values/tethering_vpn_strings.xml
new file mode 100644
index 00000000000..2975c7d6a6c
--- /dev/null
+++ b/res/values/tethering_vpn_strings.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+     SPDX-FileCopyrightText: Paranoid Android
+     SPDX-License-Identifier: Apache-2.0
+-->
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <string name="tethering_allow_vpn_upstreams_title">Use VPN for connected devices</string>
+    <string name="tethering_allow_vpn_upstreams_summary">When this device is using a VPN, all devices connected to the hotspot will use the same VPN</string>
+</resources>
diff --git a/res/xml/tether_prefs.xml b/res/xml/tether_prefs.xml
index 33a51d82a0a..ca8e42c64a1 100644
--- a/res/xml/tether_prefs.xml
+++ b/res/xml/tether_prefs.xml
@@ -49,6 +49,12 @@
         android:summary="@string/ethernet_tethering_subtext"
         settings:keywords="@string/keywords_hotspot_tethering" />
 
+    <SwitchPreferenceCompat
+        android:key="tethering_allow_vpn_upstreams"
+        android:title="@string/tethering_allow_vpn_upstreams_title"
+        android:summary="@string/tethering_allow_vpn_upstreams_summary"
+        settings:controller="com.android.settings.network.tether.TetheringAllowVpnUpstreamsPreferenceController" />
+
     <com.android.settingslib.widget.FooterPreference
         android:key="disabled_on_data_saver"
         android:title="@string/tether_settings_disabled_on_data_saver"
diff --git a/src/com/android/settings/network/tether/TetheringAllowVpnUpstreamsPreferenceController.java b/src/com/android/settings/network/tether/TetheringAllowVpnUpstreamsPreferenceController.java
new file mode 100644
index 00000000000..4194a0188d8
--- /dev/null
+++ b/src/com/android/settings/network/tether/TetheringAllowVpnUpstreamsPreferenceController.java
@@ -0,0 +1,47 @@
+/*
+ * SPDX-FileCopyrightText: Paranoid Android
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.network.tether;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/**
+ * Lets hotspot clients use the VPN of the main user. Tethering reads the same
+ * secure setting and follows the VPN as its upstream while it is on.
+ */
+public class TetheringAllowVpnUpstreamsPreferenceController extends TogglePreferenceController {
+
+    private static final String TETHERING_ALLOW_VPN_UPSTREAMS = "tethering_allow_vpn_upstreams";
+
+    public TetheringAllowVpnUpstreamsPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.Secure.getInt(mContext.getContentResolver(),
+                TETHERING_ALLOW_VPN_UPSTREAMS, 0) == 1;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.Secure.putInt(mContext.getContentResolver(),
+                TETHERING_ALLOW_VPN_UPSTREAMS, isChecked ? 1 : 0);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_network;
+    }
+}
