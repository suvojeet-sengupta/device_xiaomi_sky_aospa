diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/policy/NetworkTraffic.java b/packages/SystemUI/src/com/android/systemui/statusbar/policy/NetworkTraffic.java
new file mode 100644
index 000000000000..c7b7434792b4
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/policy/NetworkTraffic.java
@@ -0,0 +1,141 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Paranoid Android
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.systemui.statusbar.policy;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.ContentObserver;
+import android.graphics.Rect;
+import android.net.TrafficStats;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.PowerManager;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.provider.Settings;
+import android.text.format.Formatter;
+import android.util.AttributeSet;
+import android.view.View;
+import android.widget.TextView;
+
+import com.android.systemui.plugins.DarkIconDispatcher;
+import com.android.systemui.plugins.DarkIconDispatcher.DarkReceiver;
+import com.android.systemui.res.R;
+
+import java.util.ArrayList;
+
+/**
+ * Shows how fast data moves, down and up together, in the status bar while
+ * Settings.Secure.NETWORK_TRAFFIC_ENABLED is on. It hides below 1 KB/s and
+ * only counts while the screen is on.
+ */
+public class NetworkTraffic extends TextView implements DarkReceiver {
+    public static final String NETWORK_TRAFFIC_ENABLED = "network_traffic_enabled";
+
+    private static final long INTERVAL_MILLIS = 1000;
+    private static final long MIN_BYTES_PER_SECOND = 1024;
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Runnable mTick = this::tick;
+
+    private final ContentObserver mObserver = new ContentObserver(mHandler) {
+        @Override
+        public void onChange(boolean selfChange) {
+            update();
+        }
+    };
+
+    private final BroadcastReceiver mScreenReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            mScreenOn = Intent.ACTION_SCREEN_ON.equals(intent.getAction());
+            update();
+        }
+    };
+
+    private boolean mAttached;
+    private boolean mScreenOn = true;
+    private long mLastBytes;
+    private long mLastTime;
+
+    public NetworkTraffic(Context context) {
+        this(context, null);
+    }
+
+    public NetworkTraffic(Context context, AttributeSet attrs) {
+        this(context, attrs, 0);
+    }
+
+    public NetworkTraffic(Context context, AttributeSet attrs, int defStyle) {
+        super(context, attrs, defStyle);
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        mAttached = true;
+        mContext.getContentResolver().registerContentObserver(
+                Settings.Secure.getUriFor(NETWORK_TRAFFIC_ENABLED), false, mObserver,
+                UserHandle.USER_ALL);
+        IntentFilter filter = new IntentFilter();
+        filter.addAction(Intent.ACTION_SCREEN_ON);
+        filter.addAction(Intent.ACTION_SCREEN_OFF);
+        mContext.registerReceiver(mScreenReceiver, filter, Context.RECEIVER_NOT_EXPORTED);
+        mScreenOn = mContext.getSystemService(PowerManager.class).isInteractive();
+        update();
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        mAttached = false;
+        mContext.getContentResolver().unregisterContentObserver(mObserver);
+        mContext.unregisterReceiver(mScreenReceiver);
+        update();
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    public void onDarkChanged(ArrayList<Rect> areas, float darkIntensity, int tint) {
+        setTextColor(DarkIconDispatcher.getTint(areas, this, tint));
+    }
+
+    private void update() {
+        mHandler.removeCallbacks(mTick);
+        boolean enabled = Settings.Secure.getIntForUser(mContext.getContentResolver(),
+                NETWORK_TRAFFIC_ENABLED, 0, UserHandle.USER_CURRENT) != 0;
+        if (!mAttached || !enabled || !mScreenOn) {
+            setVisibility(View.GONE);
+            return;
+        }
+        mLastBytes = totalBytes();
+        mLastTime = SystemClock.elapsedRealtime();
+        mHandler.postDelayed(mTick, INTERVAL_MILLIS);
+    }
+
+    private void tick() {
+        long bytes = totalBytes();
+        long now = SystemClock.elapsedRealtime();
+        long rate = Math.max(0, bytes - mLastBytes) * 1000 / Math.max(1, now - mLastTime);
+        mLastBytes = bytes;
+        mLastTime = now;
+
+        if (rate < MIN_BYTES_PER_SECOND) {
+            setVisibility(View.GONE);
+        } else {
+            setText(mContext.getString(R.string.network_traffic_rate,
+                    Formatter.formatShortFileSize(mContext, rate)));
+            setVisibility(View.VISIBLE);
+        }
+        mHandler.postDelayed(mTick, INTERVAL_MILLIS);
+    }
+
+    private static long totalBytes() {
+        return Math.max(0, TrafficStats.getTotalRxBytes())
+                + Math.max(0, TrafficStats.getTotalTxBytes());
+    }
+}
