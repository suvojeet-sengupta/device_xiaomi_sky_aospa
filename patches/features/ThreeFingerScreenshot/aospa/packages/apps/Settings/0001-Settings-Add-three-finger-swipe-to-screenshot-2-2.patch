diff --git a/src/com/android/settings/gestures/ThreeFingerScreenshotPreferenceController.java b/src/com/android/settings/gestures/ThreeFingerScreenshotPreferenceController.java
new file mode 100644
index 0000000..cf66e64
--- /dev/null
+++ b/src/com/android/settings/gestures/ThreeFingerScreenshotPreferenceController.java
@@ -0,0 +1,42 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Paranoid Android
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.gestures;
+
+import android.content.Context;
+import android.provider.Settings;
+
+import com.android.settings.R;
+import com.android.settings.core.TogglePreferenceController;
+
+/** Takes a screenshot when three fingers swipe down, in Settings.System.THREE_FINGER_GESTURE. */
+public class ThreeFingerScreenshotPreferenceController extends TogglePreferenceController {
+
+    public ThreeFingerScreenshotPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean isChecked() {
+        return Settings.System.getInt(mContext.getContentResolver(),
+                Settings.System.THREE_FINGER_GESTURE, 0) == 1;
+    }
+
+    @Override
+    public boolean setChecked(boolean isChecked) {
+        return Settings.System.putInt(mContext.getContentResolver(),
+                Settings.System.THREE_FINGER_GESTURE, isChecked ? 1 : 0);
+    }
+
+    @Override
+    public int getSliceHighlightMenuRes() {
+        return R.string.menu_key_system;
+    }
+}
