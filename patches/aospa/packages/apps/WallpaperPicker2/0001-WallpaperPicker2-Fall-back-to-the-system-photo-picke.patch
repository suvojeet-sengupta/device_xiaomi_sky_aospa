From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Sat, 28 Nov 2026 14:22:15 +0000
Subject: [PATCH] WallpaperPicker2: Fall back to the system photo picker for My
 photos

My photos asks for ACTION_PICK, and with no gallery app installed
nothing takes it, so picking a photo for the wallpaper crashed with an
ActivityNotFoundException. Fall back to MediaStore.ACTION_PICK_IMAGES,
the system photo picker every device has, which returns the photo the
same way.

Change-Id: Ifd6272adc30885a535225866d6eb9556abc2c091
---
 src/com/android/wallpaper/picker/MyPhotosStarter.java | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/com/android/wallpaper/picker/MyPhotosStarter.java b/src/com/android/wallpaper/picker/MyPhotosStarter.java
index f41198eba..f44615ad7 100755
--- a/src/com/android/wallpaper/picker/MyPhotosStarter.java
+++ b/src/com/android/wallpaper/picker/MyPhotosStarter.java
@@ -18,6 +18,7 @@ package com.android.wallpaper.picker;
 import android.annotation.Nullable;
 import android.app.Activity;
 import android.content.Intent;
+import android.provider.MediaStore;
 
 import androidx.activity.result.ActivityResultLauncher;
 
@@ -79,9 +80,15 @@ public interface MyPhotosStarter {
             return intent;
         }
 
+        /**
+         * The system photo picker, which every device has, for when no app takes
+         * {@link Intent#ACTION_PICK}, such as a build without a gallery app.
+         */
         @Nullable
         default Intent getFallbackIntent() {
-            return null;
+            Intent intent = new Intent(MediaStore.ACTION_PICK_IMAGES);
+            intent.setType("image/*");
+            return intent;
         }
     }
 }
